# Copy to .env before: docker compose -p yachts-staging up -d --build
# Or: cp .env.staging.example .env.staging && docker compose --env-file .env.staging -p yachts-staging up -d --build

COMPOSE_PROJECT_NAME=yachts-staging

# Host ports (nginx proxies to these; bound to 127.0.0.1)
FRONTEND_PORT=3001
BACKEND_PORT=5001

# Public URLs
CLIENT_URL=https://staging.a-s-m.yachts
CLIENT_URLS=https://staging.a-s-m.yachts
SERVER_URL=https://api.staging.a-s-m.yachts
NEXT_PUBLIC_API_URL=https://api.staging.a-s-m.yachts
NEXT_PUBLIC_SERVER_URL=https://api.staging.a-s-m.yachts

# Database (separate from live)
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DATABASE_NAME=yachts_staging

# Auth / mail
SECRET_KEY=CHANGE_ME_STAGING_SECRET
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
