# Copy to .env before: docker compose -p yachts-live up -d --build
# Or: cp .env.live.example .env.live && docker compose --env-file .env.live -p yachts-live up -d --build

COMPOSE_PROJECT_NAME=yachts-live

# Host ports (nginx proxies to these; bound to 127.0.0.1)
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Public URLs
CLIENT_URL=https://live.a-s-m.yachts
CLIENT_URLS=https://live.a-s-m.yachts
SERVER_URL=https://api.live.a-s-m.yachts
NEXT_PUBLIC_API_URL=https://api.live.a-s-m.yachts
NEXT_PUBLIC_SERVER_URL=https://api.live.a-s-m.yachts

# Database (separate from staging)
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_LIVE_DB_PASSWORD
DATABASE_NAME=yachts_live

# Auth / mail
SECRET_KEY=CHANGE_ME_LIVE_SECRET
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=
